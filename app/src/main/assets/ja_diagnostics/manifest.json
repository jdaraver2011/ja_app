{
  "manifest_version": 2,
  "name": "JA Player Interaction Diagnostics",
  "version": "1.1.0",
  "description": "Opt-in, read-only iframe-aware player diagnostics.",
  "browser_specific_settings": {"gecko": {"id": "ja-player-diagnostics@local.invalid"}},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["diagnostics.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }]
}
