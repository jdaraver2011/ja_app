{
  "manifest_version": 2,
  "name": "JA TV Remote — Output Quality Match",
  "version": "2.1.2",
  "description": "TV remote with verified quality and caption defaults, JW API discovery and custom row adapter.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "stream-diagnostics.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "exclude_matches": [
        "*://deezer.com/*",
        "*://*.deezer.com/*",
        "*://*.dzcdn.net/*",
        "*://accounts.google.com/*",
        "*://appleid.apple.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "jw-api.js",
        "output-quality.js",
        "jw-preferences.js",
        "quality-activation.js",
        "quality-menu-mask.js",
        "quality-resume.js",
        "remote.js",
        "ntv-artifact.js"
      ],
      "css": [
        "quality-menu-mask.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "exclude_matches": [
        "*://deezer.com/*",
        "*://*.deezer.com/*",
        "*://*.dzcdn.net/*",
        "*://accounts.google.com/*",
        "*://appleid.apple.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ]
    }
  ]
}
