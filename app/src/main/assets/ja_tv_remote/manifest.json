{
  "manifest_version": 2,
  "name": "JA Player Controls v1.1.2 Touch Compatibility",
  "version": "1.1.2",
  "description": "Preserve stable Android TV remote and quality behavior; restore JW Player touch input and prevent permanent mobile toolbar hiding.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "remote.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
