{
  "manifest_version": 2,
  "name": "JA TV Remote Controls v1.0.17",
  "version": "1.0.17",
  "description": "Fix invisible control-mode focus on Mute; Down reveals toolbar and control mode times out; preserves startup preferences.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "remote.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
