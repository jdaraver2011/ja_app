{
  "manifest_version": 2,
  "name": "JA TV Remote v1.1.5ax — Subtitles Off + Fast Frame Stats",
  "version": "1.1.5.5",
  "description": "TV remote controls, subtitles off by default, and 1-second video statistics for frame-rate matching.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "remote.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
