{
  "manifest_version": 2,
  "name": "JA TV Remote Controls v1.0.20",
  "version": "1.0.20",
  "description": "Use the real JW video timeline; restore toolbar navigation after hiding and select highest quality in the background when available.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "remote.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
