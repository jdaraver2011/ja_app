{
  "manifest_version": 2,
  "name": "JA TV Remote v1.1.5ay \u2014 Native Auto Quality",
  "version": "1.1.6.9",
  "description": "TV remote, subtitles off at startup, 1-second frame statistics; preserves native Auto video quality.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "remote.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
