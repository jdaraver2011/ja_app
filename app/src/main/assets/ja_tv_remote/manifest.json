{
  "manifest_version": 2,
  "name": "JA TV Remote \u2014 Output Quality Match",
  "version": "2.0.3",
  "description": "TV remote with verified quality and caption defaults, JW API discovery and custom row adapter.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "output-quality.js",
        "jw-preferences.js",
        "remote.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
