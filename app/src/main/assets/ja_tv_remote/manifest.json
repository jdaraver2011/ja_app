{
  "manifest_version": 2,
  "name": "JA Player Controls v1.1.5f VidFast Touch Isolation",
  "version": "1.1.5.2",
  "description": "Keep VidFast native touch UI untouched; log hit-testing and preserve primary VidSrc controls.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "remote.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
