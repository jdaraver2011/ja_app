{
  "manifest_version": 2,
  "name": "JA TV Remote v1.1.5ag \u2014 Title Header Auto-Hide",
  "version": "1.1.5.3",
  "description": "Preserve VidSrc and VidFast remote behavior; hide persistent title chrome after verified video start on Android TV.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "remote.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
