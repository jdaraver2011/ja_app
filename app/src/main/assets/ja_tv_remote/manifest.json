{
  "manifest_version": 2,
  "name": "JA TV Remote Controls v1.0.22",
  "version": "1.0.22",
  "description": "Suppress unattended quality/CC menus; add conservative center play/seek button discovery and hide while playing; preserve v1.0.21 remote and autoplay behavior.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-tv-remote-107@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "remote.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
