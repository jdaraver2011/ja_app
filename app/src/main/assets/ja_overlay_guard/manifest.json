{
  "manifest_version": 2,
  "name": "JA Playback Overlay Guard",
  "version": "1.1.6.20",
  "description": "Hide visibly deceptive in-page popup layers without replacing the embedded video player or changing remote controls.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-playback-overlay-guard@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "guard.js"
      ],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_start",
      "exclude_matches": [
        "*://deezer.com/*",
        "*://*.deezer.com/*",
        "*://*.dzcdn.net/*",
        "*://accounts.google.com/*",
        "*://appleid.apple.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ]
    }
  ]
}
