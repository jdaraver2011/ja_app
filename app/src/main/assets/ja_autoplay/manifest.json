{
  "manifest_version": 2,
  "name": "JA Experimental Iframe Auto-Start",
  "version": "1.1.0",
  "description": "Opt-in attempt to start embedded video players in HTTP(S) frames.",
  "browser_specific_settings": {"gecko": {"id": "ja-autoplay@local.invalid"}},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["autoplay.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }]
}
