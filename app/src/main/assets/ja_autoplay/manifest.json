{
  "manifest_version": 2,
  "name": "JA Experimental Iframe Auto-Start",
  "version": "1.1.5",
  "description": "Opt-in attempt to start embedded video players in HTTP(S) frames.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-autoplay@local.invalid"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://thedaddy.li/stream/stream-*.php"
      ],
      "css": [
        "daddylive-player.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://ntv.cx/*",
        "https://ntv.cx/*",
        "http://*.ntv.cx/*",
        "https://*.ntv.cx/*",
        "http://ntv.st/*",
        "https://ntv.st/*",
        "http://*.ntv.st/*",
        "https://*.ntv.st/*",
        "http://ntvs.cx/*",
        "https://ntvs.cx/*",
        "http://*.ntvs.cx/*",
        "https://*.ntvs.cx/*",
        "http://ntvstream.cx/*",
        "https://ntvstream.cx/*",
        "http://*.ntvstream.cx/*",
        "https://*.ntvstream.cx/*",
        "http://cryptotiptv.pro/*",
        "https://cryptotiptv.pro/*",
        "http://*.cryptotiptv.pro/*",
        "https://*.cryptotiptv.pro/*"
      ],
      "js": ["ntv-ui.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "movy-landing.js",
        "autoplay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "exclude_matches": [
        "*://deezer.com/*",
        "*://*.deezer.com/*",
        "*://*.dzcdn.net/*",
        "*://accounts.google.com/*",
        "*://appleid.apple.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ]
    }
  ]
}
