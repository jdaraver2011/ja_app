{
  "manifest_version": 2,
  "name": "JA Experimental Iframe Auto-Start",
  "version": "1.1.4",
  "description": "Opt-in attempt to start embedded video players in HTTP(S) frames.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-autoplay@local.invalid"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://thedaddy.li/stream/stream-*.php"
      ],
      "css": [
        "daddylive-player.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "movy-landing.js",
        "autoplay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "exclude_matches": [
        "*://deezer.com/*",
        "*://*.deezer.com/*",
        "*://*.dzcdn.net/*",
        "*://accounts.google.com/*",
        "*://appleid.apple.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ]
    }
  ]
}
