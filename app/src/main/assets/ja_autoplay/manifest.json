{
  "manifest_version": 2,
  "name": "JA Experimental Video Autoplay",
  "version": "1.0.0",
  "description": "Attempt HTML5 video playback without clicking page overlays.",
  "browser_specific_settings": {"gecko": {"id": "ja-autoplay@local.invalid"}},
  "content_scripts": [{
    "matches": ["*://vidsrc.sh/*", "*://*.vidsrc.sh/*"],
    "js": ["autoplay.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
