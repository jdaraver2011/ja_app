{
  "manifest_version": 2,
  "name": "JA Source Availability Monitor",
  "version": "1.1.6.12",
  "description": "Validated player activity, duration-aware progress, resume and stall reporting.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-source-status@local.invalid"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "status.js"
      ],
      "all_frames": true,
      "match_about_blank": false,
      "run_at": "document_idle",
      "exclude_matches": [
        "*://deezer.com/*",
        "*://*.deezer.com/*",
        "*://*.dzcdn.net/*",
        "*://accounts.google.com/*",
        "*://appleid.apple.com/*",
        "*://facebook.com/*",
        "*://*.facebook.com/*"
      ]
    }
  ]
}
