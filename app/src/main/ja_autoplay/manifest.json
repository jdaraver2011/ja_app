{
  "manifest_version": 2,
  "name": "JA Iframe Auto-Start Restored",
  "version": "2.0.0",
  "description": "Iframe HTML5 autoplay; no TV focus injection or frame sampling",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-autoplay-restored-20261031@local.invalid"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "autoplay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
