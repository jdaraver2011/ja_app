{
  "manifest_version": 2,
  "name": "JA Experimental Iframe Auto-Start",
  "version": "1.3.0",
  "description": "JA iframe autoplay, playback diagnostics, and Google TV web-player focus support",
  "browser_specific_settings": {
    "gecko": {
      "id": "ja-autoplay@local.invalid"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "autoplay.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
